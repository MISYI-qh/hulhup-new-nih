{
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 512
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/cron/phipop-post?slot=am",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/cron/phipop-post?slot=pm",
      "schedule": "0 14 * * *"
    }
  ]
}